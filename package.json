{
    "name": "MingdaoSIG",
    "version": "2.9.1",
    "description": "",
    "main": "index.ts",
    "scripts": {
        "build": "tsc && tsc-alias",
        "build:watch": "tsc && (concurrently \"tsc -w\" \"tsc-alias -w\")",
        "start": "node dist/index.js",
        "start:dev": "nodemon --delay 1 dist/index.js",
        "dev": "concurrently \"npm run build:watch\" \"npm run start:dev\"",
        "check-and-fix-lint": "(echo '\n---\n\nScanning for lint error...' && eslint .) || (echo '\n\n---\n\nFound lint error, working on it...' && eslint . --fix) || echo \"\n\nWARNING: There are some error that can't be fixed automatically!\"",
        "lintfix": "npm run --silent check-and-fix-lint"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@types/jsonwebtoken": "^9.0.10",
        "axios": "^1.21.1",
        "compression": "^1.8.2",
        "cors": "^2.8.6",
        "dotenv": "^16.6.1",
        "express": "^5.3.0",
        "express-rate-limit": "^6.11.2",
        "jsonwebtoken": "^9.0.3",
        "mongoose": "^9.12.1",
        "morgan": "^1.12.1",
        "sharp": "^0.32.6",
        "tsc-alias": "^1.9.10",
        "uuid": "^9.0.1"
    },
    "devDependencies": {
        "@types/compression": "^1.8.1",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/morgan": "^1.9.10",
        "@types/node": "^24.19.2",
        "@types/uuid": "^9.0.8",
        "@typescript-eslint/eslint-plugin": "^6.21.0",
        "@typescript-eslint/parser": "^5.62.0",
        "concurrently": "^8.2.2",
        "eslint": "^8.57.1",
        "eslint-plugin-import": "^2.32.0",
        "nodemon": "^3.1.14",
        "prettier": "^2.8.8",
        "prettier-eslint": "^16.4.2",
        "typescript": "^6.0.3"
    }
}
